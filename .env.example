# Required before creating CHW accounts or storing/syncing health records.
KV_REST_API_URL=
KV_REST_API_TOKEN=
RCHW_SESSION_SECRET=
RCHW_DATA_ENCRYPTION_KEY=

# reCAPTCHA v3 and low-score v2 fallback. Secrets stay server-side.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

# Optional outbound contact email using Nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=

# Optional WhatsApp Cloud API notifications for partnership enquiries.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_PHONE=
WHATSAPP_API_VERSION=v22.0

# Public canonical URL used in metadata and email links.
NEXT_PUBLIC_SITE_URL=https://raphaelhealth.co.ke
